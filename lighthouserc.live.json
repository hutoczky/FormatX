{
  "ci": {
    "collect": {
      "url": [
        "https://formatxsuite.com/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "maxWaitForLoad": 60000,
        "pauseAfterLoadMs": 800
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1.0, "aggregationMethod": "pessimistic" }],
        "categories:accessibility": ["error", { "minScore": 1.0, "aggregationMethod": "pessimistic" }],
        "categories:best-practices": ["error", { "minScore": 1.0, "aggregationMethod": "pessimistic" }],
        "categories:seo": ["error", { "minScore": 1.0, "aggregationMethod": "pessimistic" }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1800, "aggregationMethod": "pessimistic" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1999, "aggregationMethod": "pessimistic" }],
        "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "pessimistic" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.049, "aggregationMethod": "pessimistic" }],
        "server-response-time": ["error", { "maxNumericValue": 500, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
