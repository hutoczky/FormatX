{
  "ci": {
    "collect": {
      "url": [
        "https://www.formatxsuite.com/?lighthouse=1&live=desktop"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --force-prefers-reduced-motion",
        "maxWaitForLoad": 60000,
        "pauseAfterLoadMs": 800,
        "skipAudits": [
          "render-blocking-resources",
          "unused-css-rules",
          "unminified-css"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "server-response-time": ["error", { "maxNumericValue": 1000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
