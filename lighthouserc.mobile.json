{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8788/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "throttlingMethod": "devtools",
        "maxWaitForLoad": 60000,
        "pauseAfterLoadMs": 800
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1.0 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1999 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.049 }],
        "server-response-time": ["error", { "maxNumericValue": 500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
