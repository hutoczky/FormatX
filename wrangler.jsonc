{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formatxsuite",
  "main": "worker.js",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "formatxsuite.com",
      "custom_domain": true
    },
    {
      "pattern": "www.formatxsuite.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/scifi-ui/",
      "/scifi-ui/index.html",
      "/scifi-ui/scripts/formatx-event-horizon.js",
      "/scifi-ui/scripts/formatx-mobile-recovery.js",
      "/scifi-ui/scripts/formatx-intro-deadlock-guard.js",
      "/download/*",
      "/scifi-ui/downloads/FormatX-Suite-Pro-Android.apk"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
