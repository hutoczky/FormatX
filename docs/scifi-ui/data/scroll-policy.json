{
  "schema_version": 1,
  "revision": "2026-08-12-production-hardening-v4",
  "policy": {
    "input_capture": false,
    "section_scroll_snap": false,
    "native_wheel_touch": true
  },
  "mobile": {
    "controller": "seamless-v7",
    "automatic_loop": true,
    "visual_bridge": true,
    "cloned_content": false,
    "cloned_hero_only": true,
    "automatic_page_position_changes": true,
    "boundary_handoff_only": true,
    "transfer_mode": "scrollend-or-idle",
    "native_momentum_preserved": true,
    "finite_document": false
  },
  "desktop": {
    "controller": "seamless-v7",
    "automatic_loop": true,
    "visual_bridge": true,
    "cloned_content": false,
    "cloned_hero_only": true,
    "boundary_handoff_only": true,
    "native_wheel_input": true
  }
}
