      ],
      "required_for_active_download": true,
      "fallback": {
        "hu": "Teljes multiplatform verzió letöltése",
        "en": "Download full multiplatform version"
      }
    },
    "android": {
      "status_source": "platform-status.json#android",
      "configured_url": "/download/android",
      "asset_patterns": [
        "^FormatX-Suite-Pro-Android-.*\\.apk$"
      ],
      "required_for_active_download": true,
      "fallback": {
        "hu": "Android teljes verzió",
        "en": "Android full version"
      }
    }
  },
  "public_display": {
    "show_release_version": false,
    "show_internal_component_versions": false,
    "package_label": {
      "hu": "Teljes multiplatform verzió",
      "en": "Full multiplatform version"
    },
    "trial_label": {
      "hu": "5 napos próbalicenc",
      "en": "5-day trial licence"
