{
  "schema_version": 1,
  "site_revision": "r206.1",
  "purpose": "fail-open mobile first paint, WebGL-independent layout and award performance recovery",
  "contracts": {
    "webgl_independent_layout": true,
    "visible_mag_fallback": true,
    "hero_copy_visible_at_first_paint": true,
    "hidden_copy_state_removed": true,
    "negative_hero_overlap_removed": true,
    "mobile_css_preloaded_by_production_worker": true,
    "sound_toggle_muted_by_default": true,
    "adaptive_mobile_gpu_target_fps": 60,
    "production_lighthouse_thresholds_unchanged": true
  },
  "targets": {
    "performance_score_min": 0.9,
    "first_contentful_paint_ms_max": 1800,
    "largest_contentful_paint_ms_max": 2500,
    "total_blocking_time_ms_max": 200,
    "cumulative_layout_shift_max": 0.1,
    "server_response_time_ms_max": 600,
    "accessibility_score": 1,
    "best_practices_score": 1,
    "seo_score": 1
  },
  "validation": {
    "mode": "production-live",
    "runs_per_lighthouse_profile": 3,
    "audit_only_shortcuts_forbidden": true,
    "threshold_lowering_forbidden": true
  },
  "created_at": "2026-08-18",
  "final_validation_requested_at": "2026-08-18T14:50:00+02:00"
